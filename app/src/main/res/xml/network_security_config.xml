<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin on a home network is usually plain http (e.g. 192.168.x.x:8096), so allow it.
     User-installed certificates are trusted too, for home servers with their own https certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
